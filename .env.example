# Required: SerpApi flight/hotel search
SECRET_API_KEY=

# Required: LangGraph supervisor and specialist synthesis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low

# Required for current travel-condition research and risk monitoring
TAVILY_API_KEY=

# User-local date/time interpretation; this is not passport nationality
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Optional user profile; set only when explicitly provided by the traveler
TRAVEL_USER_ID=local-user
# TRAVELER_PASSPORT_COUNTRY=India

# Persistent local data
TRAVEL_RISK_DB_PATH=travel_risk.db
CHECKPOINTER_TYPE=memory
# CHECKPOINT_DB_PATH=travel_checkpoints.db
SERPAPI_LIMIT_DB_PATH=search_limits.db

# Search budgets; set monthly cap to match your actual SerpApi plan
SERPAPI_MAX_CALLS_PER_MINUTE=20
SERPAPI_MAX_CALLS_PER_DAY=100
SERPAPI_MAX_CALLS_PER_MONTH=200

# Search breadth / provider budgets
MAX_EXPLORE_AIRPORTS=12
TRAVEL_RESEARCH_MAX_RESULTS=5
TRAVEL_RISK_MAX_SOURCES=5
RISK_SCHEDULER_INTERVAL_MINUTES=60
RISK_ALERT_MIN_LEVEL=moderate
